# HackPay — Razorpay + AWS DynamoDB + Strands/Bedrock (Ship It)

RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAYX_ACCOUNT_NUMBER=
PORT=3000

AWS_REGION=ap-south-1
NEXT_PUBLIC_AWS_REGION=ap-south-1

NEXT_PUBLIC_COGNITO_USER_POOL_ID=
NEXT_PUBLIC_COGNITO_CLIENT_ID=

# DynamoDB (from CDK output DynamoTableName — usually hackpay-data)
DYNAMODB_TABLE_NAME=hackpay-data

NEXT_PUBLIC_S3_BUCKET=
NEXT_PUBLIC_CLOUDFRONT_URL=

SNS_TOPIC_ARN=
NEXT_PUBLIC_SNS_TOPIC_ARN=

AGENT_CRON_SECRET=

# Strands Agents + Amazon Bedrock (advisory orchestration — never moves money)
STRANDS_ENABLED=true
BEDROCK_MODEL_ID=amazon.nova-lite-v1:0
# Optional override if the model is enabled in another region
# BEDROCK_REGION=ap-south-1
# Optional: higher GitHub API rate limits for repo analysis
# GITHUB_TOKEN=
