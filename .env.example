# HackPay — Razorpay + AWS DynamoDB + Strands/Bedrock (Ship It)

RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAYX_ACCOUNT_NUMBER=
PORT=3000

AWS_REGION=ap-south-1
NEXT_PUBLIC_AWS_REGION=ap-south-1

NEXT_PUBLIC_COGNITO_USER_POOL_ID=
NEXT_PUBLIC_COGNITO_CLIENT_ID=

# DynamoDB (from CDK output DynamoTableName — usually hackpay-data)
DYNAMODB_TABLE_NAME=hackpay-data

NEXT_PUBLIC_S3_BUCKET=
NEXT_PUBLIC_CLOUDFRONT_URL=

SNS_TOPIC_ARN=
NEXT_PUBLIC_SNS_TOPIC_ARN=

# Optional: Secrets Manager ARN for Razorpay JSON (used only if Amplify env keys are empty)
# RAZORPAY_SECRET_ARN=

# Optional: verified SES identity for “you won” emails
# SES_FROM_EMAIL=noreply@yourdomain.com

AGENT_CRON_SECRET=

# Strands Agents + Amazon Bedrock (advisory orchestration — never moves money)
STRANDS_ENABLED=true
BEDROCK_MODEL_ID=amazon.nova-lite-v1:0
# Optional override if the model is enabled in another region
# BEDROCK_REGION=ap-south-1
# Optional: higher GitHub API rate limits for repo analysis
# GITHUB_TOKEN=

# ── Submission assessment agents (Nasiko + Anakin; not DronaHQ) ─
# Anakin: surf public GitHub repo URLs → markdown
# Get key: https://anakin.io/dashboard
ANAKIN_API_KEY=

# Nasiko git-eval agent URL (local or deployed)
# Local: cd agents/git-eval && node server.js  → http://localhost:8787/evaluate
NASIKO_GIT_EVAL_URL=http://127.0.0.1:8000/evaluate
# NASIKO_GIT_EVAL_API_KEY=

# Shared secret for agent → HackPay assessment callback
SUBMISSION_AGENT_CALLBACK_SECRET=

# Optional Nasiko observability ping
# NASIKO_OBSERVE_WEBHOOK_URL=

# Optional legacy DronaHQ fan-out (not required)
# DRONAHQ_SUBMISSION_WEBHOOK_URL=
# DRONAHQ_WEBHOOK_API_KEY=

# DronaHQ PDF Creator — professional assessment PDF export
# Create a published Regular template + Automation with GetPDFURL, then set:
# https://docs.dronahq.com/pdf-creator-overview/
# DRONAHQ_PDF_GENERATE_URL=https://YOUR_DRONAHQ_AUTOMATION_WEBHOOK
# DRONAHQ_PDF_TEMPLATE_ID=
# DRONAHQ_PDF_API_KEY=

# Supabase mirror for agents (optional)
# SUPABASE_URL=https://YOUR_PROJECT.supabase.co
# SUPABASE_SERVICE_ROLE_KEY=
