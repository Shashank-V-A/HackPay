# HackPay — Razorpay + AWS (Ship It)

# Payments (optional — mock receipts if unset)
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAYX_ACCOUNT_NUMBER=
PORT=3000

# ── AWS (preferred for Bharat Builds Ship It) ─────────────────
AWS_REGION=ap-south-1
NEXT_PUBLIC_AWS_REGION=ap-south-1

# Cognito (from CDK outputs UserPoolId / UserPoolClientId)
NEXT_PUBLIC_COGNITO_USER_POOL_ID=
NEXT_PUBLIC_COGNITO_CLIENT_ID=

# RDS Postgres (from CDK: build from RdsEndpoint + Secrets Manager password)
# postgresql://hackpay:PASSWORD@HOST:5432/hackpay?sslmode=require
DATABASE_URL=

# S3 + CloudFront (receipts / audit exports)
NEXT_PUBLIC_S3_BUCKET=
AWS_S3_BUCKET=
NEXT_PUBLIC_CLOUDFRONT_URL=

# SNS alerts (agent notifications)
SNS_TOPIC_ARN=
NEXT_PUBLIC_SNS_TOPIC_ARN=

# EventBridge Lambda → /api/agent/tick (from Secrets Manager hackpay/agent-cron-secret)
AGENT_CRON_SECRET=

# Optional fallback — Supabase (used only when DATABASE_URL is unset)
# NEXT_PUBLIC_SUPABASE_URL=
# NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# SUPABASE_SERVICE_ROLE_KEY=
