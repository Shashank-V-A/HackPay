# HackPay — Razorpay + AWS (Ship It)

# Payments (optional — mock receipts if unset)
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAYX_ACCOUNT_NUMBER=
PORT=3000

# ── AWS (required) ────────────────────────────────────────────
AWS_REGION=ap-south-1
NEXT_PUBLIC_AWS_REGION=ap-south-1

# Cognito
NEXT_PUBLIC_COGNITO_USER_POOL_ID=
NEXT_PUBLIC_COGNITO_CLIENT_ID=

# RDS Postgres
# postgresql://hackpay:PASSWORD@HOST:5432/hackpay?sslmode=require
DATABASE_URL=

# S3 + CloudFront
NEXT_PUBLIC_S3_BUCKET=
AWS_S3_BUCKET=
NEXT_PUBLIC_CLOUDFRONT_URL=

# SNS
SNS_TOPIC_ARN=
NEXT_PUBLIC_SNS_TOPIC_ARN=

# EventBridge Lambda → /api/agent/tick
AGENT_CRON_SECRET=
